---
import Layout from "../layouts/Layout.astro"

import "../styles/uses.scss"
---

<Layout title="Uses | Murendeni Mukwevho">
  <main class="main-wrapper w-100 h-100">
    <section class="section-wrapper py-5" id="uses-intro-section">
      <div class="section-content">
        <div class="container">
          <h1>
            <a href="/" class="home">Murendeni Mukwevho</a> is a developer based
            in Johannesburg, South Africa. Currently breaking the bias at <a
              href="//www.girlcode.co.za/">GirlCode</a
            >
          </h1>
          <p class="mt-4">Below are few tools and services I use everyday</p>
        </div>
      </div>
    </section>
    <section class="section-wrapper py-5" id="uses-section">
      <div class="section-content container">
        <div class="category">
          <h4 class="category-title">Hardware</h4>
          <ul class="category-uses mt-3">
            <li>Lenovo IdeaPad 5<span>laptop</span></li>
            <li>Dell S2240Lc<span>monitor</span></li>
            <li>Logitech K780<span>keyboard</span></li>
            <li>Logitech M720<span>mouse</span></li>
            <li>Samsung S21 FE<span>phone</span></li>
            <li>Sony WH-CH500<span>headset</span></li>
          </ul>
        </div>
        <div class="category mt-5">
          <h4 class="category-title">Development</h4>
          <ul class="category-uses mt-3">
            <li>VS Code<span>editor</span></li>
            <li>Google Chrome<span>browser</span></li>
            <li>Notion<span>task management</span></li>
            <li>Terminal<span>terminal</span></li>
            <li>Insomnia<span>api</span></li>
          </ul>
        </div>
        <div class="category mt-5">
          <h4 class="category-title">Extras</h4>
          <ul class="category-uses mt-3">
            <li>Youtube Music<span>music</span></li>
            <li>DSTV, Plex &amp; Showmax<span>tv shows</span></li>
            <li>Google Keeps<span>notes</span></li>
            <li>Google Podcast<span>podcast</span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
